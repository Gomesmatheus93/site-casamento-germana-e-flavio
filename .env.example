# Mercado Pago (obtenha em https://www.mercadopago.com.br/developers/panel)
MP_ACCESS_TOKEN="APP_USR-xxxx (ou TEST-xxxx para testes)"
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-xxxx (ou TEST-xxxx para testes)"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Firebase — Admin SDK (server-side), da chave de conta de serviço
# (Project settings -> Service accounts -> Generate new private key)
FIREBASE_PROJECT_ID="seu-projeto-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase — Web app config (client SDK, usado só na página /admin/login)
# (Project settings -> General -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
